# LLM provider — Google Gemini 2.5 Flash (Generative Language API).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings (semantic search). Provider is auto-selected, first available wins:
#   1. GEMINI_API_KEY  -> gemini-embedding-001 (default; reuses the key above)
#   2. VOYAGE_API_KEY  -> voyage-finance-2 (finance-tuned alternative)
#   3. OPENAI_API_KEY  -> text-embedding-3-small
# With GEMINI_API_KEY set, no extra key is needed for chat retrieval.
OPENAI_API_KEY=
VOYAGE_API_KEY=
