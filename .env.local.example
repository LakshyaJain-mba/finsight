# LLM provider — Google Gemini 2.5 Flash (Generative Language API).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Embedding provider — set ONE of the following.
# If VOYAGE_API_KEY is present it is used (voyage-finance-2), otherwise OpenAI.
OPENAI_API_KEY=
VOYAGE_API_KEY=
